# Copy this file to ".env" (git-ignored) before running `docker compose up`.
# Docker Compose reads ".env" automatically and substitutes these into docker-compose.yml.
# These are throwaway local values - fine to use as-is for a local run; change them for anything real.

# MySQL root password (used only inside the mysql container, e.g. for its health check)
MYSQL_ROOT_PASSWORD=rootpass

# The application database user that both MySQL and the Spring Boot app use
DB_USERNAME=gameflix_app
DB_PASSWORD=gameflix_pass

# JWT signing secret - must be at least 32 characters (256 bits) for HS512
JWT_SECRET=docker-compose-demo-secret-please-change-0123456789
