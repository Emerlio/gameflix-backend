# Copy this file to application-local.properties (git-ignored) and fill in real values,
# OR supply the same settings as environment variables (DB_URL, DB_USERNAME, DB_PASSWORD,
# JWT_SECRET, JWT_EXP_MINUTES, CORS_ORIGIN). Never commit real secrets.

spring.datasource.url=jdbc:mysql://localhost:3306/gameflix_auth?useSSL=false&serverTimezone=UTC
spring.datasource.username=YOUR_DB_USER
spring.datasource.password=YOUR_DB_PASSWORD

# JWT signing secret. Must be at least 32 characters (256 bits) for HS256.
app.jwt.secret=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
app.jwt.expiration-minutes=60

# Front-end origin allowed by CORS (never use "*").
app.cors.allowed-origin=http://localhost:3000
